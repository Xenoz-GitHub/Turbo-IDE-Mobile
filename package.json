{
  "name": "turbo-cpp-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "cap:init": "cap init",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "build:apk": "node scripts/build-apk.js",
    "build:apk:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:apk:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:run": "npm run build && npx cap sync android && npx cap run android",
    "security:audit": "npm audit --production",
    "security:audit:all": "npm audit",
    "security:fix": "npm audit fix",
    "security:check": "npm run security:audit && npm run lint"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sanitize-filename": "^1.6.4",
    "uuid": "^14.0.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^15.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "capacitor": {
    "appId": "com.encryptedcrew.turbocpp",
    "appName": "Turbo C++ Mobile",
    "webDir": "dist"
  }
}
